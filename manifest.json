{
  "manifest_version": 3,
  "name": "Getty / iStock 图片助手",
  "version": "2.4.0",
  "minimum_chrome_version": "102",
  "description": "读取正常网页中的 Getty / iStock 公开图源，保留原始像素，预览后手动下载。无需本地软件。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://media.gettyimages.com/*",
    "https://media.istockphoto.com/*",
    "https://short.askingtips.com/uploads/*",
    "https://gettyimages.com/*",
    "https://www.gettyimages.com/*",
    "https://gettyimages.ae/*",
    "https://www.gettyimages.ae/*",
    "https://gettyimages.co.uk/*",
    "https://www.gettyimages.co.uk/*",
    "https://gettyimages.de/*",
    "https://www.gettyimages.de/*",
    "https://gettyimages.fr/*",
    "https://www.gettyimages.fr/*",
    "https://gettyimages.es/*",
    "https://www.gettyimages.es/*",
    "https://gettyimages.it/*",
    "https://www.gettyimages.it/*",
    "https://gettyimages.jp/*",
    "https://www.gettyimages.jp/*",
    "https://gettyimages.com.br/*",
    "https://www.gettyimages.com.br/*",
    "https://gettyimages.com.au/*",
    "https://www.gettyimages.com.au/*",
    "https://gettyimages.ca/*",
    "https://www.gettyimages.ca/*",
    "https://gettyimages.in/*",
    "https://www.gettyimages.in/*",
    "https://gettyimages.cn/*",
    "https://www.gettyimages.cn/*",
    "https://gettyimages.nl/*",
    "https://www.gettyimages.nl/*",
    "https://gettyimages.se/*",
    "https://www.gettyimages.se/*",
    "https://gettyimages.pl/*",
    "https://www.gettyimages.pl/*",
    "https://gettyimages.mx/*",
    "https://www.gettyimages.mx/*",
    "https://gettyimages.com.mx/*",
    "https://www.gettyimages.com.mx/*",
    "https://gettyimages.co.jp/*",
    "https://www.gettyimages.co.jp/*",
    "https://gettyimages.com.hk/*",
    "https://www.gettyimages.com.hk/*",
    "https://gettyimages.com.sg/*",
    "https://www.gettyimages.com.sg/*",
    "https://gettyimages.pt/*",
    "https://www.gettyimages.pt/*",
    "https://gettyimages.ru/*",
    "https://www.gettyimages.ru/*",
    "https://gettyimages.ch/*",
    "https://www.gettyimages.ch/*",
    "https://gettyimages.at/*",
    "https://www.gettyimages.at/*",
    "https://gettyimages.be/*",
    "https://www.gettyimages.be/*",
    "https://gettyimages.dk/*",
    "https://www.gettyimages.dk/*",
    "https://gettyimages.no/*",
    "https://www.gettyimages.no/*",
    "https://gettyimages.fi/*",
    "https://www.gettyimages.fi/*",
    "https://gettyimages.gr/*",
    "https://www.gettyimages.gr/*",
    "https://gettyimages.tr/*",
    "https://www.gettyimages.tr/*",
    "https://gettyimages.co.kr/*",
    "https://www.gettyimages.co.kr/*",
    "https://gettyimages.hk/*",
    "https://www.gettyimages.hk/*",
    "https://gettyimages.co.nz/*",
    "https://www.gettyimages.co.nz/*",
    "https://gettyimages.co.za/*",
    "https://www.gettyimages.co.za/*",
    "https://gettyimages.ie/*",
    "https://www.gettyimages.ie/*",
    "https://gettyimages.tw/*",
    "https://www.gettyimages.tw/*",
    "https://www.istockphoto.com/*",
    "https://istockphoto.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Getty / iStock 图片助手 · 读取当前页或打开工作台"
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'; img-src 'self' blob: data: https://media.gettyimages.com https://media.istockphoto.com https://short.askingtips.com;"
  }
}
